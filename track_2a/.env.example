# Apertus 1.5 8B, OpenAI-compatible (vLLM, Ollama, a hosted endpoint, ...)
# - Apertus on this machine outside Docker: http://host.docker.internal:8000/v1
# - `make run-gpu` (Apertus in Docker):       http://apertus:8000/v1
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=none
# Only for `make run-gpu`: Hugging Face token with access to the gated Apertus weights
HF_TOKEN=
# Only for evaluation (make eval): simulator Gemini Flash, judge Claude Opus 5.5
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
